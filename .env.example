# 이 파일은 템플릿이다. 실제 값은 .env.local 또는 Vercel 환경변수에 넣는다.
# .env* 는 .gitignore 에 있고 이 예시 파일만 예외로 커밋된다.

# 공개 도메인 (프로토콜 포함, 후행 슬래시 없이).
# 【배포 차단】 이 값이 없으면 전 페이지의 canonical 과 hreflang 절대 URL이
# http://localhost:3000 으로 생성된다 — 검색엔진에 무효한 주소가 올라간다.
NEXT_PUBLIC_SITE_URL=https://example.com

# 이 사이트의 공개 저장소 주소.
# 설정된 경우에만 홈 "일하는 방식" 섹션의 저장소 링크가 앵커로 렌더된다.
# 비워 두면 문장만 남고 링크가 만들어지지 않는다 — 저장소를 만들기 전에 404를 배포하지 않기 위해서다.
NEXT_PUBLIC_REPO_URL=
